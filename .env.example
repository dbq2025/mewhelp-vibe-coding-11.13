# ===== 复制为 .env 后按需修改；.env 不进版本库 =====

# --- 应用 ---
ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- 数据库（对应 docker-compose.yml，宿主端口 5433）---
PG_DSN=postgresql+asyncpg://app:app_dev_pwd@127.0.0.1:5433/ecom
DB_ECHO=false

# --- 鉴权（生产必须替换，用 openssl rand -hex 32 生成）---
JWT_SECRET=dev-only-change-me

# --- LLM / Embedding（P1 起才会真正调用）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 批量与限流：一次 16 条、并发 4；免费额度下不要调太高
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CONCURRENCY=4

# --- RAG 检索（P1 纯向量，P3 加混合检索）---
RAG_TOP_K=5
# 余弦距离阈值，超过即丢弃（0~1，越小越严）
RAG_MAX_DISTANCE=0.45

# --- 限流（P4）---
# 每个 IP 每分钟放行的请求数；0 = 关闭（跑 scripts/eval.py 时建议临时设 0）
RATE_LIMIT_PER_MINUTE=30

# --- 运维看板（P4）---
# 留空则 /api/v1/admin/metrics 返回 404（默认关闭）
ADMIN_TOKEN=

# 模型单价（元 / 百万 token），只用于成本估算，调价改这里
LLM_PRICE_INPUT_PER_MTOK=2.0
LLM_PRICE_OUTPUT_PER_MTOK=3.0
